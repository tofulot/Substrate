{
  "name": "substrate",
  "version": "0.2.1",
  "private": true,
  "description": "A local-first workspace for building with AI",
  "main": "out/main/index.js",
  "author": "Substrate",
  "license": "MIT",
  "scripts": {
    "dev": "cargo build -p agent-server && electron-vite dev",
    "build": "npm run typecheck && electron-vite build && cargo build --release -p agent-server",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "cargo test --workspace && python3 tests/integration.py",
    "preview": "electron-vite preview",
    "package:mac": "npm run build && node scripts/prepare-tools.mjs && electron-builder --mac dir",
    "dist:mac": "npm run build && node scripts/prepare-tools.mjs && electron-builder --mac dmg",
    "test:desktop": "node tests/electron.mjs",
    "format": "prettier --write src electron shared *.json *.ts",
    "check": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && npm run typecheck"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  },
  "build": {
    "appId": "dev.substrate.desktop",
    "productName": "Substrate",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "target/release/agent-server",
        "to": "agent-server"
      },
      {
        "from": "resources/bin/rg",
        "to": "bin/rg"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null,
      "icon": "resources/icon.icns"
    }
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "dompurify": "^3.4.17"
  }
}
